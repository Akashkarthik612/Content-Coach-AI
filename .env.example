# Copy this to .env and fill in your values — never commit .env
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/content_coach
REDIS_URL=redis://localhost:6379/0
LANGCHAIN_API_KEY_GEMINI=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
OPENAI_API_KEY=
APP_NAME=Content Coach
ENV=development

# Supabase Auth — Project Settings -> Data API -> Project URL (e.g. https://xxxx.supabase.co)
# Backend verifies JWTs via this project's public JWKS endpoint; no shared secret needed.
SUPABASE_URL=https://your-project-ref.supabase.co

# Auth provider switch — "supabase" (default, used in prod) or "local" (dev-only
# bcrypt + X-User-Id auth against your local Postgres, see backend/auth_local/).
# Leave unset/"supabase" for anything that touches production or real Supabase.
AUTH_PROVIDER=supabase

# LinkedIn OAuth — get these from developer.linkedin.com
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/linkedin/auth/callback
FRONTEND_URL=http://localhost:5173

# Extra CORS origins beyond the hardcoded localhost/CloudFront list in main.py —
# e.g. your Vercel deployment URL(s), comma-separated.
EXTRA_ALLOWED_ORIGINS=
