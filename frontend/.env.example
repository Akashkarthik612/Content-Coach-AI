# Copy this to .env and fill in your values — never commit .env
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key_here

# Auth mode switch — "supabase" (default, used in prod) or "local" (dev-only,
# talks to the backend's AUTH_PROVIDER=local password endpoints instead of Supabase).
VITE_AUTH_MODE=supabase

# Absolute origin of the backend API (e.g. https://your-app.onrender.com).
# Leave empty for local dev — Vite's /api proxy (vite.config.js) handles it.
VITE_API_BASE_URL=
